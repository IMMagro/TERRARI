---
// Font self-hosted (nessuna CDN esterna → migliore performance/CLS)
import '@fontsource/cormorant/500.css';
import '@fontsource/cormorant/600.css';
import '@fontsource/cormorant/700.css';
import '@fontsource/cormorant/600-italic.css';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og-default.jpg',
  noindex = false,
} = Astro.props;

const siteName = 'Terrari — Ecosistemi su misura';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0B0F12" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-surface focus:px-4 focus:py-2 focus:text-ink">Salta al contenuto</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Autoscroll dolce dopo 20s di inattività; qualsiasi interazione lo ferma e resetta.
      (() => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const IDLE_MS = 20000;
        const SPEED = 1.1; // px per frame (~66px/s a 60fps): lento e dolce
        let idleTimer: number | undefined;
        let rafId: number | null = null;
        let auto = false;

        const atBottom = () =>
          window.scrollY >= document.documentElement.scrollHeight - window.innerHeight - 1;

        function stop() {
          auto = false;
          if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
        }
        function step() {
          if (!auto) return;
          if (atBottom()) { stop(); return; }
          window.scrollBy({ top: SPEED, behavior: 'instant' as ScrollBehavior });
          rafId = requestAnimationFrame(step);
        }
        function start() {
          if (auto || atBottom()) return;
          auto = true;
          rafId = requestAnimationFrame(step);
        }
        function reset() {
          stop();
          clearTimeout(idleTimer);
          idleTimer = window.setTimeout(start, IDLE_MS);
        }
        // Attività utente reale (NON lo scroll programmatico dell'autoscroll)
        ['mousemove', 'mousedown', 'keydown', 'wheel', 'touchstart', 'pointerdown'].forEach((ev) =>
          window.addEventListener(ev, reset, { passive: true }),
        );
        reset();
      })();
    </script>
  </body>
</html>
