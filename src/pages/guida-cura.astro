---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { Sun, Droplets, Scissors } from 'lucide-react';

const temi = [
  {
    Icon: Sun,
    t: 'Luce',
    d: 'Un habitat tropicale vuole 10–12 ore di luce al giorno, sempre agli stessi orari: con la presa smart lo imposti una volta e basta. Mai sole diretto sul vetro: la teca si scalda come una serra.',
  },
  {
    Icon: Droplets,
    t: 'Umidità',
    d: 'Nebulizza una o due volte al giorno e lascia che l’ambiente asciughi tra una volta e l’altra. Se i vetri restano appannati per giorni, arieggia di più. Usa acqua demineralizzata, anche per la cascata, per evitare il calcare.',
  },
  {
    Icon: Scissors,
    t: 'Manutenzione',
    d: 'Pota le piante quando crescono troppo, togli le foglie secche e controlla la pompa della cascata una volta al mese. Un habitat bioattivo ben avviato tende all’equilibrio: meno intervieni, meglio è.',
  },
];
---

<Base
  title="Guida alla cura — Muska Habitat"
  description="Come si tiene vivo un terrario bioattivo: luce, umidità e manutenzione spiegate in modo semplice."
>
  <PageHero
    eyebrow="Cura"
    title="Come si tiene vivo un ecosistema"
    intro="Un habitat ben progettato lavora quasi da solo. Ecco le tre cose da tenere d’occhio. A ogni consegna spiego tutto di persona."
  />

  <section class="atmosphere">
    <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20">
      <div class="grid gap-6 md:grid-cols-3">
        {temi.map(({ Icon, t, d }) => (
          <article class="glass rounded-2xl p-7">
            <span
              class="flex h-12 w-12 items-center justify-center rounded-xl border border-line/70"
              style="color: var(--color-tropic-bright);"
            >
              <Icon size={24} strokeWidth={1.4} />
            </span>
            <h2 class="mt-5 font-display text-2xl font-semibold text-ink">{t}</h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">{d}</p>
          </article>
        ))}
      </div>

      <p class="mt-12 text-center text-sm text-ink-mute">
        Hai un dubbio sul tuo habitat? Scrivimi a muskahabitat@gmail.com o su Instagram @muska.habitat.
      </p>
    </div>
  </section>
</Base>
