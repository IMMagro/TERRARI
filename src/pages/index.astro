---
import Base from '../layouts/Base.astro';
import HeroReveal from '../components/HeroReveal.astro';
import FeatureBox from '../components/FeatureBox.astro';
import BiomeBackdrop from '../components/BiomeBackdrop.astro';
import InquiryForm from '../components/react/InquiryForm.tsx';

const promesse = [
  'Sopralluogo e progettazione del microclima',
  'Costruzione artigianale, un pezzo alla volta',
  'Consegna, installazione e guida alla cura',
];
---

<Base
  title="Terrari — Ecosistemi viventi su misura"
  description="Terrari artigianali costruiti a mano: mondi tropicali e desertici sotto vetro, progettati come microclimi autonomi. Pezzi unici e progetti su commissione."
>
  <HeroReveal />

  {/* Box "Opere in evidenza" con geco che sbircia */}
  <FeatureBox />

  {/* CTA immersiva: sfondo bioma ciclante (crossfade), contenuto sul lato scuro a sinistra */}
  <section id="contatto" class="relative isolate overflow-hidden border-t border-white/10">
    <BiomeBackdrop />
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-24 sm:px-8 sm:py-32 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow" style="color: var(--color-arid-bright);">Su misura</p>
        <h2 class="mt-3 font-display text-4xl font-semibold text-white sm:text-5xl [text-shadow:0_2px_18px_rgba(0,0,0,0.55)]">
          Immagina il tuo, lo costruiamo noi
        </h2>
        <p class="mt-4 max-w-md text-white/85">
          Raccontaci lo spazio, il bioma e l’atmosfera che hai in mente.
          Progettiamo un microclima su misura e ti rispondiamo con una prima
          proposta, senza impegno.
        </p>
        <ul class="mt-7 flex flex-col gap-3.5">
          {promesse.map((p) => (
            <li class="flex items-start gap-3 text-sm text-white/85">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="mt-0.5 shrink-0" style="color: var(--color-tropic-bright);">
                <path d="m5 13 4 4L19 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {p}
            </li>
          ))}
        </ul>
      </div>

      <InquiryForm client:visible />
    </div>
  </section>
</Base>
