---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import InquiryForm from '../components/react/InquiryForm.tsx';

const passi = [
  { n: '01', t: 'Bioma', d: 'Tropicale, desertico, paludario o wabi-kusa.' },
  { n: '02', t: 'Dimensioni', d: 'Spazio a disposizione e formato del vetro.' },
  { n: '03', t: 'Equipaggiamento', d: 'Illuminazione smart, nebulizzazione, setup bioattivo.' },
  { n: '04', t: 'Contatti', d: 'Ti ricontattiamo con una proposta su misura.' },
];
---

<Base
  title="Su misura — Terrari"
  description="Configura il tuo terrario su misura: bioma, dimensioni, automazione. Progettiamo un microclima autonomo e ti rispondiamo con una proposta."
>
  <PageHero
    eyebrow="Su misura"
    title="Configura il tuo terrario"
    intro="Il configuratore passo-passo è in arrivo. Nel frattempo raccontaci il progetto: leggiamo ogni richiesta e rispondiamo con una prima proposta."
    accent="arid"
  />

  <section class="atmosphere">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-2 lg:items-start">
      <div>
        <p class="eyebrow" style="color: var(--color-arid-bright);">Come funzionerà</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-ink sm:text-4xl">
          Quattro passi, un ecosistema
        </h2>
        <ol class="mt-8 flex flex-col gap-6">
          {passi.map((p) => (
            <li class="flex gap-4">
              <span class="font-mono text-sm tracking-widest text-ink-mute">{p.n}</span>
              <div>
                <h3 class="font-display text-xl font-semibold text-ink">{p.t}</h3>
                <p class="mt-1 text-sm text-ink-soft">{p.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div>
        <InquiryForm client:visible />
      </div>
    </div>
  </section>
</Base>
