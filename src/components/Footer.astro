---
const year = new Date().getFullYear();
const cols = [
  {
    title: 'Esplora',
    links: [
      { href: '/galleria', label: 'Lavori' },
      { href: '/custom', label: 'Progetto su misura' },
      { href: '/guida-cura', label: 'Guida alla cura' },
    ],
  },
  {
    title: 'Contatti',
    links: [
      { href: '/contatti', label: 'Scrivimi' },
      { href: '/custom', label: 'Richiedi un preventivo' },
      { href: 'https://www.instagram.com/muska.habitat/', label: 'Instagram' },
      { href: 'https://www.tiktok.com/@muska.habitat', label: 'TikTok' },
    ],
  },
];
---

<footer class="atmosphere border-t border-line/60">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-8 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-display text-2xl font-semibold text-ink">Muska Habitat</p>
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-soft">
        Terrari bioattivi fatti a mano a San Giovanni Valdarno (AR).
        Sfondi 3D scolpiti, cascate e luci smart. muskahabitat@gmail.com
      </p>
    </div>

    {cols.map((col) => (
      <div>
        <p class="eyebrow mb-4">{col.title}</p>
        <ul class="flex flex-col gap-2.5">
          {col.links.map((l) => (
            <li>
              <a href={l.href} target={l.href.startsWith("http") ? "_blank" : undefined} rel={l.href.startsWith("http") ? "noopener" : undefined} class="text-sm text-ink-soft transition-colors hover:text-ink">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="border-t border-line/40">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-2 px-5 py-6 text-xs text-ink-mute sm:flex-row sm:items-center sm:px-8">
      <p>© {year} Muska Habitat · San Giovanni Valdarno (AR)</p>
      <p class="font-mono tracking-wider">Progettato in penombra, con umidità controllata.</p>
    </div>
  </div>
</footer>
