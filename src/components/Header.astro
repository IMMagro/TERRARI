---
const nav = [
  { href: '/', label: 'Home' },
  { href: '/galleria', label: 'Galleria' },
  { href: '/custom', label: 'Su misura' },
  { href: '/guida-cura', label: 'Cura' },
  { href: '/contatti', label: 'Contatti' },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 w-full transition-all duration-500 ease-out py-3 sm:py-4 px-3 sm:px-6 pointer-events-none"
>
  <div
    id="header-island"
    class="mx-auto flex h-14 max-w-6xl items-center justify-between gap-4 px-5 sm:px-8 pointer-events-auto rounded-none border border-transparent bg-transparent transition-all duration-500 ease-out"
  >
    {/* Marchio */}
    <a href="/" class="group flex items-center gap-2.5" aria-label="Terrari — home">
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0">
        <path d="M12 3.5c-4.4 0-7.5 3.3-7.5 7.6 0 3 1.7 5.6 4.3 6.9v1.2h6.4v-1.2c2.6-1.3 4.3-3.9 4.3-6.9C19.5 6.8 16.4 3.5 12 3.5Z" stroke="var(--color-tropic-bright)" stroke-width="1.2" opacity="0.7"/>
        <path d="M12 18V9.5m0 0c0-1.6 1.2-2.9 3-3.2-.2 1.8-1.4 3-3 3.2Zm0 1.4c0-1.5-1.1-2.6-2.8-2.9.2 1.7 1.3 2.7 2.8 2.9Z" stroke="var(--color-tropic-bright)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="font-display text-xl font-semibold tracking-tight text-ink">Terrari</span>
    </a>

    {/* Nav desktop */}
    <nav class="hidden items-center gap-7 md:flex" aria-label="Principale">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'text-sm transition-colors hover:text-white',
            isActive(item.href) ? 'text-white font-semibold' : 'text-ink-soft',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:block">
      <a
        href="/custom"
        class="rounded-full border border-tropic/40 bg-tropic/10 px-4 py-2 text-sm font-medium text-white transition-all hover:bg-tropic/25 hover:border-tropic/60 shadow-sm"
      >
        Richiedi un progetto
      </a>
    </div>

    {/* Menu mobile */}
    <details class="relative md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-line/60 text-ink [&::-webkit-details-marker]:hidden"
        aria-label="Apri il menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </summary>
      <nav
        class="absolute right-0 mt-3 flex w-56 flex-col gap-1 rounded-xl border border-line/70 bg-bg-deep/95 p-2 shadow-2xl backdrop-blur-xl"
        aria-label="Principale"
      >
        {nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-2 text-sm transition-colors hover:bg-white/5',
              isActive(item.href) ? 'text-ink' : 'text-ink-soft',
            ]}
          >
            {item.label}
          </a>
        ))}
        <a href="/custom" class="mt-1 rounded-lg bg-tropic/15 px-3 py-2 text-sm font-medium text-ink">
          Richiedi un progetto
        </a>
      </nav>
    </details>
  </div>
</header>

<script>
  // Animazione dinamica per trasformare l'Header in Menu Island fluttuante allo scorrimento
  const headerIsland = document.getElementById('header-island');

  function updateIsland() {
    if (!headerIsland) return;
    if (window.scrollY > 30) {
      headerIsland.classList.add(
        'max-w-4xl',
        'rounded-full',
        'bg-[#0b0f12]/85',
        'backdrop-blur-xl',
        'border-white/15',
        'shadow-[0_20px_50px_rgba(0,0,0,0.7)]',
        'px-6',
        'sm:px-8'
      );
      headerIsland.classList.remove('max-w-6xl', 'rounded-none', 'border-transparent', 'bg-transparent');
    } else {
      headerIsland.classList.remove(
        'max-w-4xl',
        'rounded-full',
        'bg-[#0b0f12]/85',
        'backdrop-blur-xl',
        'border-white/15',
        'shadow-[0_20px_50px_rgba(0,0,0,0.7)]',
        'px-6',
        'sm:px-8'
      );
      headerIsland.classList.add('max-w-6xl', 'rounded-none', 'border-transparent', 'bg-transparent');
    }
  }

  window.addEventListener('scroll', updateIsland, { passive: true });
  updateIsland();
</script>
