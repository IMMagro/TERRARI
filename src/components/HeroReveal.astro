---
// Hero "spotlight reveal" (maschera radiale) + layout a fasce + particelle.
// Costruita al lavoro (pacchetto hud/data/terrari/), integrata nel design system.
// - Reveal: due foto pixel-allineate del geco (ambra sopra, perla sotto). L'immagine
//   sopra si "buca" sotto il cursore (CSS mask radiale) e svela quella sotto.
//   Su mobile → passata automatica. Nessuna isola React: vanilla JS + CSS mask + canvas.
// - Rispetta prefers-reduced-motion.
// Morph via astro:assets: content-hashed (cache-safe in produzione, freschi in dev).
import ambraImg from '../assets/hero/gecko-ambra.webp';
import biancoImg from '../assets/hero/gecko-bianco.webp';

interface Props {
  base?: string; // immagine "sopra" (morph ambra / arido)
  reveal?: string; // immagine svelata "sotto" (morph perla)
  eyebrow?: string;
  baseAlt?: string;
  revealAlt?: string;
}
const {
  base = ambraImg.src,
  reveal = biancoImg.src,
  eyebrow = 'Atelier · Terrari su misura',
  baseAlt = 'Geco crestato, morph ambra',
  revealAlt = 'Geco crestato, morph perla',
} = Astro.props;
---

<section class="hero">
  <div class="hero__stage" id="hero-stage">
    <img class="hero__img hero__img--reveal" src={reveal} alt={revealAlt} />
    <img class="hero__img hero__img--base" src={base} alt={baseAlt} />
    <div class="hero__spot" aria-hidden="true"></div>
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <canvas class="hero__motes" id="hero-motes" aria-hidden="true"></canvas>

  <div class="hero__ui">
    <div class="hero__main">
      <div class="wrap">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="title">Un vetro,<br /><em>due mondi.</em></h1>
        <p class="lede">
          Ecosistemi viventi costruiti a mano, calibrati sulla specie e sullo spazio.
          Passa sul geco: ogni terrario custodisce più di quanto mostri.
        </p>
        <div class="cta">
          <a class="btn btn--primary" href="/custom">Configura il tuo terrario</a>
          <a class="btn btn--ghost" href="/galleria">Esplora la galleria&nbsp;→</a>
        </div>
      </div>
    </div>

    <footer class="hero__bottom">
      <div class="scroll">scorri <b>↓</b></div>
      <div class="hint" id="hero-hint"><span class="dot pulse"></span>muovi il mouse sul geco</div>
    </footer>
  </div>

  <div class="hero__side" aria-hidden="true">Fatti a mano · su misura</div>
</section>

<style>
  /* Token agganciati al design system reale (global.css @theme) */
  .hero {
    --bg: var(--color-bg);
    --ink: var(--color-ink);
    --muted: var(--color-ink-soft);
    --amber: var(--color-arid-bright);
    --emerald: var(--color-tropic-bright);
    --line: rgba(234, 241, 237, 0.14);
    --glass: rgba(255, 255, 255, 0.06);
    --serif: var(--font-display);
    --sans: var(--font-sans);
    --mono: var(--font-mono);
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    isolation: isolate;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
  }

  .hero__stage {
    position: absolute;
    inset: 0;
    --r: 0px;
    --x: 50%;
    --y: 60%;
    transition: --r 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero__stage.is-active {
    --r: clamp(150px, 20vmin, 300px);
  }
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Geco spostato a destra: in idle non copre testo/CTA (che stanno a sinistra).
       NB: con overflow orizzontale la % è "inversa" — valori bassi = soggetto più a destra. */
    object-position: 30% bottom;
    pointer-events: none;
    user-select: none;
  }
  .hero__img--reveal {
    z-index: 1;
  }
  .hero__img--base {
    z-index: 2;
    -webkit-mask-image: radial-gradient(circle var(--r) at var(--x) var(--y), #0000 0%, #0000 50%, #000 84%);
    mask-image: radial-gradient(circle var(--r) at var(--x) var(--y), #0000 0%, #0000 50%, #000 84%);
  }
  .hero__spot {
    position: absolute;
    left: 0;
    top: 0;
    width: 600px;
    height: 600px;
    margin: -300px 0 0 -300px;
    transform: translate(var(--x), var(--y));
    z-index: 4;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.45s ease;
    mix-blend-mode: screen;
    filter: blur(8px);
    background: radial-gradient(circle, rgba(34, 197, 94, 0.2), rgba(234, 179, 8, 0.12) 42%, transparent 68%);
  }
  .hero__stage.is-active .hero__spot {
    opacity: 1;
  }
  .hero__motes {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background:
      linear-gradient(103deg, rgba(11, 15, 18, 0.9) 0%, rgba(11, 15, 18, 0.5) 30%, rgba(11, 15, 18, 0) 56%),
      linear-gradient(180deg, rgba(11, 15, 18, 0.62) 0%, rgba(11, 15, 18, 0) 16%),
      linear-gradient(0deg, rgba(11, 15, 18, 0.72) 0%, rgba(11, 15, 18, 0) 20%),
      radial-gradient(130% 90% at 44% 46%, transparent 54%, rgba(6, 8, 10, 0.72) 100%);
  }

  .hero__ui {
    position: relative;
    z-index: 5;
    min-height: 100vh;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 24px;
    pointer-events: none;
    max-width: 1640px;
    margin-inline: auto;
    padding: clamp(22px, 3vw, 44px) clamp(24px, 5vw, 72px);
  }

  .hero__main {
    display: flex;
    align-items: center;
  }
  .wrap {
    max-width: 660px;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--amber);
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 28px;
  }
  .eyebrow::before {
    content: "";
    width: 38px;
    height: 1px;
    background: linear-gradient(90deg, var(--amber), transparent);
  }
  .title {
    font-family: var(--serif);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.015em;
    font-size: clamp(54px, 8.6vw, 132px);
    margin-bottom: 24px;
  }
  .title em {
    font-style: italic;
    color: transparent;
    background: linear-gradient(92deg, var(--emerald), var(--ink) 55%, var(--amber));
    -webkit-background-clip: text;
    background-clip: text;
  }
  .lede {
    font-size: clamp(16px, 1.4vw, 19px);
    line-height: 1.6;
    color: var(--muted);
    max-width: 46ch;
    margin-bottom: 38px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }
  .btn {
    pointer-events: auto;
    font-weight: 600;
    font-size: 15px;
    padding: 15px 26px;
    border-radius: 999px;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    transition: 0.25s ease;
    border: 1px solid transparent;
  }
  .btn--primary {
    color: var(--bg);
    background: var(--amber);
    box-shadow: 0 8px 30px -8px rgba(234, 179, 8, 0.5);
  }
  .btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 40px -10px rgba(234, 179, 8, 0.6);
  }
  .btn--ghost {
    color: var(--ink);
    border-color: var(--line);
    background: var(--glass);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .btn--ghost:hover {
    border-color: rgba(234, 241, 237, 0.4);
    transform: translateY(-2px);
  }

  .hero__bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }
  .legend {
    display: flex;
    gap: 20px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .legend span {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .legend i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
  }
  .scroll {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .scroll b {
    font-weight: 400;
    animation: hero-bob 1.8s ease-in-out infinite;
    display: inline-block;
  }
  @keyframes hero-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }
  .hint {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 15px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(11, 15, 18, 0.4);
    backdrop-filter: blur(6px);
    transition: opacity 0.5s ease;
  }
  .hint.gone {
    opacity: 0;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--emerald);
  }
  .dot.pulse {
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6);
    animation: hero-pulse 2s infinite;
  }
  @keyframes hero-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5);
    }
    70% {
      box-shadow: 0 0 0 12px rgba(34, 197, 94, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  .hero__side {
    position: absolute;
    right: clamp(10px, 1.5vw, 22px);
    top: 50%;
    transform: translateY(-50%);
    writing-mode: vertical-rl;
    z-index: 5;
    pointer-events: none;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(234, 241, 237, 0.34);
  }

  @media (max-width: 820px) {
    .hero__side {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .hero__scrim {
      background: linear-gradient(0deg, rgba(11, 15, 18, 0.92) 4%, rgba(11, 15, 18, 0.2) 46%, rgba(11, 15, 18, 0.55) 100%);
    }
    .hero__ui {
      gap: 16px;
    }
    .hero__main {
      align-items: flex-start;
      padding-top: 6vh;
    }
    .legend,
    .scroll {
      display: none;
    }
    .hero__bottom {
      justify-content: flex-start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__stage {
      transition: none;
    }
    .dot.pulse,
    .scroll b {
      animation: none;
    }
  }
</style>

<!-- @property va globale (Astro non lo scope-a): abilita la transizione del raggio -->
<style is:global>
  @property --r {
    syntax: "<length>";
    inherits: true;
    initial-value: 0px;
  }
</style>

<script>
  // ---- reveal: maschera radiale che segue il cursore (posizione diretta) ----
  (function () {
    const stage = document.getElementById('hero-stage');
    const hint = document.getElementById('hero-hint');
    if (!stage) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = matchMedia('(hover: none)').matches;
    let tx = 0, ty = 0, cx = 0, cy = 0, raf: number | null = null, moving = false, touched = false;
    const rect = () => stage.getBoundingClientRect();
    const apply = () => { stage.style.setProperty('--x', cx + 'px'); stage.style.setProperty('--y', cy + 'px'); };
    const center = () => { const r = rect(); tx = cx = r.width * 0.5; ty = cy = r.height * 0.62; apply(); };
    function loop() {
      cx += (tx - cx) * 0.4; cy += (ty - cy) * 0.4; apply();
      if (moving || Math.abs(tx - cx) > 0.4 || Math.abs(ty - cy) > 0.4) raf = requestAnimationFrame(loop); else raf = null;
    }
    const kick = () => { if (!raf) raf = requestAnimationFrame(loop); };
    const activate = (on: boolean) => stage.classList.toggle('is-active', on);
    const hideHint = () => hint && hint.classList.add('gone');
    center();
    // pointer: posizione diretta (nessuno smoothing sul movimento del mouse)
    stage.addEventListener('pointermove', (e) => {
      touched = true; hideHint();
      const r = rect(); tx = cx = e.clientX - r.left; ty = cy = e.clientY - r.top; apply();
    });
    stage.addEventListener('pointerenter', () => { activate(true); });
    stage.addEventListener('pointerleave', () => { moving = false; activate(false); });
    function intro() {
      if (reduce || touched) return;
      activate(true); kick();
      const r = rect(), t0 = performance.now(), dur = 2600;
      (function step(now) {
        if (touched) return;
        const p = Math.min(1, (now - t0) / dur);
        const e = p < .5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2;
        tx = r.width * (0.34 + e * 0.34); ty = r.height * 0.68; moving = true; kick();
        if (p < 1) requestAnimationFrame(step); else { moving = false; activate(false); }
      })(t0);
    }
    function autosweep() {
      if (reduce) return;
      activate(true);
      const r = rect(), t0 = performance.now();
      (function step(now) {
        const s = (now - t0) / 2600;
        tx = r.width * (0.5 + Math.sin(s) * 0.22); ty = r.height * (0.66 + Math.cos(s * 0.9) * 0.05);
        moving = true; kick(); requestAnimationFrame(step);
      })(t0);
    }
    addEventListener('resize', center);
    if (coarse) { hideHint(); setTimeout(autosweep, 500); } else { setTimeout(intro, 900); }
  })();

  // ---- particelle: spore/pulviscolo che salgono dal basso ----
  (function () {
    const hero = document.querySelector('.hero') as HTMLElement | null;
    const canvas = document.getElementById('hero-motes') as HTMLCanvasElement | null;
    if (!hero || !canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DPR = Math.min(2, window.devicePixelRatio || 1);
    let W = 0, H = 0, parts: any[] = [], raf: number | null = null, t = 0;
    function fit() {
      const r = hero!.getBoundingClientRect(); W = r.width; H = r.height;
      canvas!.width = Math.round(W * DPR); canvas!.height = Math.round(H * DPR);
      canvas!.style.width = W + 'px'; canvas!.style.height = H + 'px'; ctx!.setTransform(DPR, 0, 0, DPR, 0, 0);
    }
    function mk(low: boolean) {
      const amber = Math.random() < 0.22;
      return { x: Math.random() * W, y: low ? (H * 0.9 + Math.random() * H * 0.2) : (H * 0.4 + Math.random() * H * 0.65),
        r: 0.5 + Math.random() * 1.9, vy: -(0.12 + Math.random() * 0.5),
        amp: 6 + Math.random() * 22, ph: Math.random() * 6.28, sp: 0.2 + Math.random() * 0.5,
        col: amber ? '226,188,128' : '168,224,196', a: 0.10 + Math.random() * 0.26 };
    }
    function seed() { const n = Math.min(70, Math.round(W / 26)); parts = []; for (let i = 0; i < n; i++) parts.push(mk(false)); }
    function fade(y: number) { const top = H * 0.22; return y <= top ? 0 : Math.min(1, (y - top) / (H * 0.5)); }
    function draw(anim: boolean) {
      ctx!.clearRect(0, 0, W, H); ctx!.globalCompositeOperation = 'lighter';
      for (let i = 0; i < parts.length; i++) {
        const p = parts[i];
        if (anim) { p.y += p.vy; if (p.y < H * 0.18) { parts[i] = mk(true); continue; } }
        const x = anim ? p.x + Math.sin(t * p.sp + p.ph) * p.amp : p.x;
        const a = p.a * fade(p.y) * (anim ? 1 : 0.85); if (a <= 0.001) continue;
        const R = p.r * 4, g = ctx!.createRadialGradient(x, p.y, 0, x, p.y, R);
        g.addColorStop(0, 'rgba(' + p.col + ',' + a.toFixed(3) + ')'); g.addColorStop(1, 'rgba(' + p.col + ',0)');
        ctx!.fillStyle = g; ctx!.beginPath(); ctx!.arc(x, p.y, R, 0, 6.283); ctx!.fill();
      }
      ctx!.globalCompositeOperation = 'source-over';
    }
    function frame() { t += 0.016; draw(true); raf = requestAnimationFrame(frame); }
    function start() { fit(); seed(); draw(!reduce); if (!reduce && !raf) raf = requestAnimationFrame(frame); }
    let rt: number | undefined; addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => { fit(); seed(); draw(!reduce); }, 150); });
    start();
  })();
</script>
