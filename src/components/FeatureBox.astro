---
import { Image } from 'astro:assets';
import gecko from '../assets/gecko-peek.webp';
import ProcessSteps from './ProcessSteps.astro';

const obras = [
  { cover: "/images/tropicale-cover.png", biome: "Bioma Tropicale", title: "Selva Sospesa", color: "#22c55e" },
  { cover: "/images/paludario-cover.png", biome: "Bioma Paludario", title: "Sponda Emersa", color: "#10b981" },
  { cover: "/images/deserto-cover.png",   biome: "Bioma Desertico",  title: "Meridiana Minerale", color: "#eab308" },
  { cover: "/images/oasis-cover.png",     biome: "Bioma Ripario",    title: "Oasis Nera", color: "#14b8a6" },
  { cover: "/images/tropicale-cover.png", biome: "Bioma Arido",      title: "Canyon di Quarzo", color: "#f59e0b" },
  { cover: "/images/paludario-cover.png", biome: "Bioma Foresta",    title: "Ombra Primordiale", color: "#059669" },
];

const panels = [
  {
    id: 'bioattivo',
    badge: '🌿 Bioattivo 100%',
    title: 'Ciclo Naturale Vivo',
    desc: 'Ecosistema autosufficiente con substrati biologici vivi, flora tropicale e microfauna per l’equilibrio naturale del terreno.',
    img: '/images/card-bioattivo.png',
    color: '#22c55e'
  },
  {
    id: 'vetro',
    badge: '💎 Vetro Extra-Chiaro',
    title: 'Trasparenza Cristallina',
    desc: 'Vetro ottico extra-chiaro ad altissima trasmittanza con incollaggio invisibile a filo per una visione cristallina senza distorsioni.',
    img: '/images/card-vetro.png',
    color: '#38bdf8'
  },
  {
    id: 'clima',
    badge: '⚡ Microclima Smart',
    title: 'Automazione Integrata',
    desc: 'Centralina intelligente per la gestione automatizzata di nebulizzazione, ventilazione e fotoperiodo LED solare.',
    img: '/images/card-clima.png',
    color: '#eab308'
  }
];
---

<section
  id="opere"
  style="padding: 5rem 0 7rem; background: radial-gradient(60% 55% at 15% 0%, rgba(16,185,129,0.08), transparent 60%), radial-gradient(55% 50% at 100% 100%, rgba(217,119,6,0.07), transparent 55%), #0b0f12;"
>
  <div class="mx-auto max-w-[1400px] px-4 sm:px-6 lg:px-8">
    <div style="position: relative; margin-bottom: 4rem;">
      
      {/* CONTENITORE PRINCIPALE CARD GLASS — SENZA OVERFLOW-HIDDEN PER FAR USCIRE IL GECO FUORI DALLA CARD */}
      <div
        class="glass relative rounded-3xl border border-white/12 bg-[#0b0f12] shadow-2xl min-h-[380px] sm:min-h-[420px]"
      >

        {/* GECO PEEK 3D OVERFLOW: SBORDA FUORI DALLA CARD (z-index 30) */}
        <div style="pointer-events: none; position: absolute; top: -8%; bottom: -8%; left: -7%; width: 48%; z-index: 30;">
          <Image
            src={gecko}
            alt="Geco crestato che sbircia"
            style="height: 116%; width: auto; max-width: none; filter: drop-shadow(0 20px 35px rgba(0,0,0,0.7)); object-fit: contain;"
          />
        </div>

        {/* 4 SEZIONI TAGLIATE IN OBLIQUO — CON OVERFLOW-HIDDEN E ROUNDED-3XL SOLO PER I PANNELLI */}
        <div class="flex h-full min-h-[380px] sm:min-h-[420px] w-full overflow-hidden rounded-3xl">
          
          {/* SEZIONE 1 (SINISTRA): VUOTA E TRASPARENTE PER FAR VEDERE LO SFONDO DEL GECO */}
          <div class="relative z-10 flex-[1.1] shrink-0 pointer-events-none"></div>

          {/* SEZIONI 2, 3, 4: PANNELLI OBLIQUI INTERATTIVI AD ALTEZZA INTERA */}
          {panels.map((panel) => (
            <div
              class="group relative flex-1 cursor-pointer overflow-hidden border-l border-white/10 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] hover:flex-[2.6]"
              style="-webkit-clip-path: polygon(10% 0, 100% 0, 100% 100%, 0% 100%); clip-path: polygon(10% 0, 100% 0, 100% 100%, 0% 100%); margin-left: -1.5rem;"
            >
              {/* Immagine di sfondo ad hoc ad altezza intera della card */}
              <div
                class="absolute inset-0 bg-cover bg-center opacity-35 scale-105 transition-all duration-700 group-hover:opacity-80 group-hover:scale-100"
                style={`background-image: url('${panel.img}');`}
              >
              </div>

              {/* Sfumatura scura per garantire leggibilità del testo */}
              <div class="absolute inset-0 bg-gradient-to-t from-[#0b0f12] via-[#0b0f12]/70 to-[#0b0f12]/40 opacity-85 transition-opacity duration-500 group-hover:opacity-60"></div>

              {/* Contenuto testuale interno a destra */}
              <div class="relative z-20 flex h-full flex-col justify-end p-6 sm:p-8 text-right">
                
                {/* Badge con colore tematico */}
                <div class="mb-3 transition-transform duration-500 group-hover:-translate-y-1">
                  <span
                    class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-[#0b0f12]/80 backdrop-blur-md px-3.5 py-1.5 text-xs font-semibold text-white shadow-lg"
                    style={`border-color: ${panel.color}60; color: ${panel.color};`}
                  >
                    {panel.badge}
                  </span>
                </div>

                {/* Titolo della sezione */}
                <h3 class="font-display text-xl sm:text-2xl font-semibold text-white transition-colors duration-300 group-hover:text-emerald-300">
                  {panel.title}
                </h3>

                {/* Testo descrittivo che appare in hover */}
                <p class="mt-2 max-h-0 overflow-hidden text-xs sm:text-sm text-white/90 leading-relaxed opacity-0 transition-all duration-500 group-hover:max-h-28 group-hover:opacity-100">
                  {panel.desc}
                </p>

                {/* Bottone Scopri di più in hover */}
                <div class="mt-4 max-h-0 overflow-hidden opacity-0 transition-all duration-500 group-hover:max-h-12 group-hover:opacity-100">
                  <a
                    href="#contatto"
                    class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-xs font-bold text-[#0b0f12] shadow-md transition-transform hover:scale-105"
                  >
                    Scopri di più →
                  </a>
                </div>
              </div>
            </div>
          ))}

        </div>
      </div>
    </div>

    {/* SEZIONE PROCESSO — full-width in primo piano (full-bleed: esce dal contenitore max-w-[1400px]) */}
    <div class="my-10 sm:my-16" style="width: 100vw; margin-inline: calc(50% - 50vw);">
      <ProcessSteps />
    </div>

    {/* CAROSELLO AUTOMATICO INFINITO IN LOOP POSIZIONATO SUBITO DOPO LA SEZIONE PROCESSO */}
    <div class="relative overflow-hidden w-full py-4 mt-8 sm:mt-12 mask-fade">
      <div class="marquee-track flex gap-5 w-max">
        {[...obras, ...obras].map((obra, idx) => (
          <div class="glass flex-shrink-0 w-[290px] sm:w-[330px]" style="border-radius: 1rem; overflow: hidden; cursor: pointer;">
            <div style="position: relative; padding-top: 70%; overflow: hidden;">
              <img
                src={obra.cover}
                alt={obra.title}
                style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;"
                onmouseenter="this.style.transform='scale(1.06)'"
                onmouseleave="this.style.transform='scale(1)'"
              />
              <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(11,15,18,0.7), transparent 50%); pointer-events: none;" />
            </div>
            <div style="padding: 1.25rem 1.5rem 1.5rem;">
              <p class="eyebrow" style={`color: ${obra.color}; margin-bottom: 0.375rem;`}>
                {obra.biome}
              </p>
              <h3 class="display" style="font-size: 1.375rem; font-weight: 600; color: white;">
                {obra.title}
              </h3>
              <a href="#contatto" style={`margin-top: 0.75rem; display: inline-flex; align-items: center; font-size: 0.8rem; color: ${obra.color}; text-decoration: none;`}>
                Scopri di più →
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    animation: marquee 55s linear infinite;
  }

  .marquee-track:hover {
    animation-play-state: paused;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .mask-fade {
    mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 4%, black 96%, transparent 100%);
  }
</style>
